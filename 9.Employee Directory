import java.util.*;

public class EmployeeDirectory {
    public static void main(String[] args) {
        ArrayList<String> employees = new ArrayList<>();

        employees.add("Rahul");
        employees.add("Amit");
        employees.add("Sneha");
        HashSet<Integer> ids = new HashSet<>();

        ids.add(101);
        ids.add(102);
        ids.add(103);

        HashMap<Integer, String> emp = new HashMap<>();

        emp.put(101, "Rahul");
        emp.put(102, "Amit");
        emp.put(103, "Sneha");

        System.out.println("Employee Names:");
        Iterator<String> it = employees.iterator();
        while (it.hasNext()) {
            System.out.println(it.next());
        }
        System.out.println("\nEmployee IDs:");
        System.out.println(ids);
        System.out.println("\nEmployee Directory:");
        for (Map.Entry<Integer, String> e : emp.entrySet()) {
            System.out.println("ID: " + e.getKey() + " Name: " + e.getValue());
        }
    }
}
