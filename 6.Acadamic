import java.util.Scanner;
interface Academic {
    void getAcademic();
    void displayAcademic();
}
interface Sports {
    void getSports();
    void displaySports();
}
class Student implements Academic, Sports {
    String name;
    int rollNo;
    float marks;
    String sport;
    int score;
    Scanner sc = new Scanner(System.in);
    public void getAcademic() {
        System.out.print("Enter Student Name: ");
        name = sc.nextLine();
        System.out.print("Enter Roll Number: ");
        rollNo = sc.nextInt();
        System.out.print("Enter Academic Marks: ");
        marks = sc.nextFloat();
        sc.nextLine();
    }
    public void getSports() {
        System.out.print("Enter Sport Name: ");
        sport = sc.nextLine();
        System.out.print("Enter Sports Score: ");
        score = sc.nextInt();
    }
    public void displayAcademic() {
        System.out.println("Name: " + name);
        System.out.println("Roll Number: " + rollNo);
        System.out.println("Academic Marks: " + marks);
    }
    public void displaySports() {
        System.out.println("Sport: " + sport);
        System.out.println("Sports Score: " + score);
    }
}
public class Acadamic {
    public static void main(String[] args) {
        Student s = new Student();
        s.getAcademic();
        s.getSports();

        System.out.println("\nStudent Details");
        s.displayAcademic();
        s.displaySports();
    }
}
